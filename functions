#!/usr/bin/env bash
# Shared helpers. Every script cd's into the repo directory and sources this file.
#
# State files kept next to the scripts (all git-ignored):
#   NetName          name of the docker network the mesh lives in
#   zookeeperIP      one line per ZooKeeper node: "<ip> <short container id>"
#   kafkaIP          one line per Kafka broker:   "<ip> <short container id>"
#   zookeeper_myid   last ZooKeeper myid handed out
#   kafka_myid       last Kafka broker.id handed out
#   log.log          full log of every run
#
# Non-interactive mode: when ZKM_NONINTERACTIVE=1 no question is asked
# (see init.sh for the variables that drive it).

ZK_CONF=/etc/zookeeper/conf
ZK_BIN=/usr/share/zookeeper/bin/zkServer.sh
ZK_PID=/var/lib/zookeeper/zookeeper_server.pid
KAFKA_HOME=/home/kafka
KAFKA_CFG=$KAFKA_HOME/config/server.properties
KAFKA_LOG=$KAFKA_HOME/logs/server.log

log() {
    local level=${1:-}
    [ $# -gt 0 ] && shift
    local time
    time=$(date +"%Y-%m-%d %X %z")

    case "$level" in
        INFO)   echo -e "\033[32m[INFO]\033[0m: $*";  echo "[$time] INFO $*" >>log.log ;;
        WARN)   echo -e "\033[33m[WARN]\033[0m: $*";  echo "[$time] WARN $*" >>log.log ;;
        ERROR)  echo -e "\033[31m[ERROR]\033[0m: $*"; echo "[$time] ERROR $*" >>log.log ;;
        INFO_s) echo "[$time] INFO $*" >>log.log ;;
        STARS)  echo -e "\n* * *\n" ;;
        *)      echo ;;
    esac
}

is_noninteractive() {
    [ "${ZKM_NONINTERACTIVE:-0}" = 1 ]
}

# Ask Yes/No. Exits the calling script: 0 = Yes, 1 = No (or end of input).
selectYN() {
    local yesno
    select yesno in "Yes" "No"; do
        log INFO_s "'$yesno' has been selected"
        if [ "$yesno" = No ]; then
            exit 1
        elif [ "$yesno" = Yes ]; then
            exit 0
        else
            log WARN "Yes/No?"
        fi
    done
    exit 1
}

net_name() {
    cat NetName
}

# Running containers of one type ($1 = zookeeper|kafka) on our network, newest first.
list_nodes() {
    docker ps -q --filter "network=$(net_name)" --filter "ancestor=baseimage-$1"
}

# IP address of container $1 on our network.
node_ip() {
    docker inspect --format "{{ (index .NetworkSettings.Networks \"$(net_name)\").IPAddress }}" "$1"
}

# myid / broker.id of container $1 of type $2.
node_id() {
    if [ "$2" = zookeeper ]; then
        docker exec "$1" cat "$ZK_CONF/myid" 2>/dev/null
    else
        docker exec "$1" sed -n 's/^broker.id=//p' "$KAFKA_CFG" 2>/dev/null
    fi
}

# Delete the line of node with IP $2 from state file $1 (portable, no sed -i).
remove_ip_line() {
    awk -v ip="$2" '$1 != ip' "$1" >"$1.tmp" && mv "$1.tmp" "$1"
}

# Rebuild $1IP from the running containers (oldest first) and resync the id
# counter $1_myid with the highest id in use, so manual changes are picked up.
refresh_state() {
    local type=$1 id lines="" max=0 n
    for id in $(list_nodes "$type"); do
        lines="$(node_ip "$id") $id"$'\n'"$lines"
        n=$(node_id "$id" "$type")
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt "$max" ]; then
            max=$n
        fi
    done
    printf '%s' "$lines" >"${type}IP"
    if [ "$max" -gt 0 ]; then
        echo "$max" >"${type}_myid"
    fi
}

# Wait until "$2" shows up in the Kafka log of container $1 after line $3.
# Gives up after $4 seconds. The log may have rolled over, then search from the top.
wait_kafka_log() {
    local id=$1 pattern=$2 from=$3 timeout=$4 waited=0
    while [ "$waited" -lt "$timeout" ]; do
        if docker exec "$id" bash -c "f=$KAFKA_LOG; [ -f \$f ] || exit 1; n=\$(wc -l <\$f); s=$from; [ \$n -lt \$s ] && s=0; tail -n +\$((s+1)) \$f | grep -q '$pattern'"; then
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    return 1
}

kafka_log_lines() {
    docker exec "$1" bash -c "[ -f $KAFKA_LOG ] && wc -l <$KAFKA_LOG || echo 0"
}

kafka_running() {
    docker exec "$1" bash -c "ps ax | grep -i 'kafka\.Kafka' | grep java | grep -qv grep"
}

# broker.id of every broker listed in kafkaIP, space separated.
live_broker_ids() {
    local ip j ids=""
    while read -r ip j; do
        [ -n "$j" ] || continue
        ids="$ids $(docker exec "$j" sed -n 's/^broker.id=//p' "$KAFKA_CFG")"
    done <kafkaIP
    echo "$ids"
}

# Wait until, as seen from broker $1, every partition has a leader and every replica
# on a live broker (from kafkaIP) is back in the ISR. Restarting or removing the next
# broker before that can leave a partition without an in-sync replica, i.e. offline.
# Partitions whose replicas are all on removed brokers are ignored (nothing to wait for).
# $1 - container id, $2 - timeout in seconds
wait_kafka_in_sync() {
    local id=$1 timeout=${2:-${ZKM_KAFKA_SYNC_TIMEOUT:-120}} waited=0 live out
    live=$(live_broker_ids)
    while [ "$waited" -lt "$timeout" ]; do
        if out=$(docker exec "$id" "$KAFKA_HOME/bin/kafka-topics.sh" --bootstrap-server localhost:9092 --describe 2>/dev/null) &&
            echo "$out" | awk -v live="$live" '
                BEGIN { n = split(live, a, " "); for (i = 1; i <= n; i++) up[a[i]] = 1 }
                /Partition: / {
                    leader = ""; reps = ""; isr = ""
                    for (i = 1; i <= NF; i++) {
                        if ($i == "Leader:")   leader = $(i + 1)
                        if ($i == "Replicas:") reps = $(i + 1)
                        if ($i == "Isr:")      isr = $(i + 1)
                    }
                    m = split(reps, r, ","); k = split(isr, s, ",")
                    delete in_isr; for (i = 1; i <= k; i++) in_isr[s[i]] = 1
                    any_live = 0
                    for (i = 1; i <= m; i++) if (r[i] in up) { any_live = 1; if (!(r[i] in in_isr)) bad = 1 }
                    if (any_live && leader == "none") bad = 1
                }
                END { exit bad }'; then
            return 0
        fi
        sleep 2
        waited=$((waited + 2))
    done
    return 1
}

# Mode reported by "srvr" on ZooKeeper container $1: leader, follower or standalone.
# Empty when the node is down or up but not serving (e.g. no quorum yet).
zk_mode() {
    docker exec "$1" bash -c "echo srvr | nc -w 2 localhost 2181" 2>/dev/null | sed -n 's/^Mode: //p'
}

# Wait until ZooKeeper on container $1 serves requests (has joined a quorum).
# A live PID is not enough: right after a restart the process runs for a while
# before the ensemble elects a leader, and clients connecting then get refused.
# $1 - container id, $2 - timeout in seconds
wait_zk_serving() {
    local id=$1 timeout=${2:-${ZKM_ZK_TIMEOUT:-90}} waited=0
    while [ "$waited" -lt "$timeout" ]; do
        case "$(zk_mode "$id")" in
            leader|follower|standalone) return 0 ;;
        esac
        sleep 1
        waited=$((waited + 1))
    done
    return 1
}

# "ip=mode" for every ZooKeeper node, e.g. "10.10.10.2=follower 10.10.10.3=leader".
zk_modes() {
    local ip j out=""
    while read -r ip j; do
        [ -n "$j" ] || continue
        out="$out $ip=$(zk_mode "$j")"
    done <zookeeperIP
    echo "${out# }"
}

# Wait until every ZooKeeper node in zookeeperIP serves requests. Brokers are restarted
# only after that, so a broker never starts against an ensemble that is still electing.
wait_zk_ensemble() {
    local ip j
    while read -r ip j; do
        [ -n "$j" ] || continue
        if ! wait_zk_serving "$j"; then
            log ERROR "zookeeper $ip is not serving requests"
            return 1
        fi
    done <zookeeperIP
}

# Health check of a node: 0 = healthy, 1 = not.
#   zookeeper: PID file exists and that process is alive. While the server list is being
#              rolled out a node can't serve yet (the others still have the old list), so
#              "is the ensemble serving" is checked once at the end with wait_zk_ensemble.
#   kafka:     broker JVM is running (RestartKafkaProcess.sh already waited for
#              "started (kafka.server.KafkaServer)", which comes after the broker
#              registered itself in ZooKeeper) and every partition is back in sync.
Check() {
    if [ "$2" = zookeeper ]; then
        sleep 2
        docker exec "$1" bash -c "[ -f $ZK_PID ] && kill -0 \$(cat $ZK_PID) 2>/dev/null"
    else
        kafka_running "$1" || return 1
        if ! wait_kafka_in_sync "$1"; then
            log ERROR "Partitions did not get back in sync on kafka $(node_ip "$1")"
            return 1
        fi
    fi
}

# Controlled shutdown of the broker on container $1: Kafka moves partition leadership
# to the other in-sync replicas before it exits. Waits for the shutdown log line.
stop_kafka() {
    local from
    kafka_running "$1" || return 0
    from=$(kafka_log_lines "$1")
    docker exec "$1" "$KAFKA_HOME/bin/kafka-server-stop.sh" >/dev/null 2>&1
    wait_kafka_log "$1" 'shut down completed (kafka.server.KafkaServer)' "$from" "${ZKM_KAFKA_STOP_TIMEOUT:-90}"
}

# Write the zoo.cfg server list on container $1 from zookeeperIP and restart ZooKeeper.
PushZoo() {
    local j ip myid servers=""
    docker exec "$1" cp -f "$ZK_CONF/zoo.cfg" "$ZK_CONF/zoo.cfg.backup"
    while read -r ip j; do
        [ -n "$j" ] || continue
        myid=$(node_id "$j" zookeeper)
        servers="${servers}server.${myid}=${ip}:2888:3888"$'\n'
    done <zookeeperIP
    printf '%s' "$servers" | docker exec -i "$1" bash -c "cp -f $ZK_CONF/zoo.cfg.template $ZK_CONF/zoo.cfg && cat >>$ZK_CONF/zoo.cfg"
    log INFO "Restart zookeeper process on container $(node_ip "$1")"
    docker exec "$1" "$ZK_BIN" restart >/dev/null 2>&1
}

RestoreZoo() {
    log INFO "Roll back and restart zookeeper process on container $(node_ip "$1")"
    docker exec "$1" cp -f "$ZK_CONF/zoo.cfg.backup" "$ZK_CONF/zoo.cfg"
    docker exec "$1" "$ZK_BIN" restart >/dev/null 2>&1
}

# Make every broker resolvable by its hostname (= short container id) on container $1.
# /etc/hosts is bind-mounted by docker, so it is rewritten with cp instead of sed -i.
UpdateKafkaHosts() {
    local ip id entries=""
    while read -r ip id; do
        if [ -n "$id" ] && [ "$id" != "$1" ]; then
            entries="${entries}${ip} ${id} # zkmesh"$'\n'
        fi
    done <kafkaIP
    printf '%s' "$entries" | docker exec -i "$1" bash -c \
        "grep -v '# zkmesh\$' /etc/hosts >/etc/hosts.zkmesh; cat >>/etc/hosts.zkmesh; cp -f /etc/hosts.zkmesh /etc/hosts"
}

# Back up, rewrite hosts + zookeeper.connect on broker $1 and restart it.
PushKafka() {
    wait_zk_ensemble || return 1
    docker exec "$1" cp -f /etc/hosts /etc/hosts.backup
    docker exec "$1" cp -f "$KAFKA_CFG" "$KAFKA_CFG.backup"
    UpdateKafkaHosts "$1"
    ./UpdateKafkaCfg.sh "$1"
    ./RestartKafkaProcess.sh "$1" kafka
}

RestoreKafka() {
    log INFO "Roll back and restart kafka process on container $(node_ip "$1")"
    docker exec "$1" cp -f /etc/hosts.backup /etc/hosts
    docker exec "$1" cp -f "$KAFKA_CFG.backup" "$KAFKA_CFG"
    ./RestartKafkaProcess.sh "$1" kafka
}

# Push the new configuration to node $1 of type $2 and health-check it.
push_and_check() {
    if [ "$2" = zookeeper ]; then
        PushZoo "$1" || return 1
    else
        PushKafka "$1" || return 1
    fi
    Check "$1" "$2"
}
